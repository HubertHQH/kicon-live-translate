QWEN_API_KEY=replace_with_your_key
QWEN_BASE_URL=https://maas.qianwenaiapi.com/compatible-mode/v1
QWEN_REALTIME_URL=wss://maas.qianwenaiapi.com/api-ws/v1/realtime
QWEN_MODEL=qwen3.8-livetranslate-flash-realtime
HOST=127.0.0.1
PORT=3210
# CNY per million tokens. Blank input-text price means unknown, not free.
QWEN_PRICE_INPUT_AUDIO=40
QWEN_PRICE_OUTPUT_TEXT=100
QWEN_PRICE_INPUT_IMAGE=3.3
QWEN_PRICE_OUTPUT_AUDIO=160
QWEN_PRICE_INPUT_TEXT=
# response.done usage is per response according to the platform reference.
# Set cumulative only if your provider explicitly returns session totals.
QWEN_USAGE_MODE=per_response
