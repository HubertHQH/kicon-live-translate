{
  "name": "kicon-live-translate",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "main": "desktop/application.cjs",
  "description": "KiCon Asia bilingual live translation and desktop captions",
  "author": "KiCon Live Translate",
  "scripts": {
    "start": "node --env-file-if-exists=.env server/index.js",
    "overlay": "node --env-file-if-exists=.env desktop/launch.cjs",
    "dev": "node --watch --env-file-if-exists=.env server/index.js",
    "test": "node --test test/*.test.js",
    "test:overlay": "node scripts/check-overlay.cjs",
    "check:api": "node --env-file-if-exists=.env scripts/check-api.js",
    "test:transport": "node --test test/server.test.js",
    "pack:win": "electron-builder --win --x64 --dir",
    "dist:win": "electron-builder --win nsis --x64",
    "test:package": "node scripts/audit-package.cjs && node scripts/check-package.cjs",
    "test:installer": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/check-installer.ps1",
    "release:bundle": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prepare-release.ps1"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "26.18.0",
    "jsdom": "^29.1.1"
  }
}
